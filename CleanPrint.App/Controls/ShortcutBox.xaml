<UserControl x:Class="CleanPrint.App.Controls.ShortcutBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TextBox x:Name="DisplayTextBox" IsReadOnly="True" Width="140" Padding="4,2"
             PreviewKeyDown="DisplayTextBox_PreviewKeyDown"
             ToolTip="Click here, then press the desired key combination. Press Escape to clear it."/>
</UserControl>
