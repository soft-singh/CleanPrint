<Window x:Class="CleanPrint.App.TextInputDialog"
        Icon="pack://application:,,,/Assets/CleanPrint.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:CleanPrint.App.Services"
        svc:UiScaling.Mode="Snapshot"
        Height="360" Width="360" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource AppWindowBackgroundBrush}" Foreground="{DynamicResource AppWindowForegroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptText" Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <TextBox x:Name="InputTextBox" Grid.Row="1" Padding="4"/>

        <TextBlock x:Name="ExistingLabel" Grid.Row="2" Text="Existing (click a name to overwrite it, or use the bin icon to delete):"
                   Margin="0,14,0,4" Foreground="{DynamicResource AppSecondaryTextBrush}" Visibility="Collapsed"/>
        <ListBox x:Name="ExistingListBox" Grid.Row="3" Visibility="Collapsed"
                 Style="{StaticResource AppListBox}" ItemContainerStyle="{StaticResource AppListBoxItem}"
                 SelectionChanged="ExistingListBox_SelectionChanged" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Padding="5,2" MinWidth="0" Margin="6,0,0,0"
                                Click="DeleteExistingItemButton_Click" Tag="{Binding}" ToolTip="Delete this preset">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconDelete}" Width="13" Height="13"/>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" Click="OkButton_Click" Padding="14,4" Margin="0,0,8,0" IsDefault="True"/>
            <Button Content="Cancel" Click="CancelButton_Click" Padding="14,4" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
