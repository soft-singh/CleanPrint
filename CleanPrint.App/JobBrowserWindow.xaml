<Window x:Class="CleanPrint.App.JobBrowserWindow"
        Icon="pack://application:,,,/Assets/CleanPrint.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:CleanPrint.App.Services"
        svc:UiScaling.Mode="Snapshot"
        Title="Open Job" Height="520" Width="920" MinWidth="760" MinHeight="400" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBackgroundBrush}" Foreground="{DynamicResource AppWindowForegroundBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Select a job to preview or reopen it, or select one or more (Ctrl/Shift-click) and delete them. Double-click a job to open it."
                   Margin="0,0,0,8" TextWrapping="Wrap"/>

        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="SearchTextBox" TextChanged="SearchTextBox_TextChanged" Height="26" VerticalContentAlignment="Center"
                     ToolTip="Filters by job name or the original image filename(s) it was created from (Open Image(s))."/>
        </DockPanel>

        <!-- Job list on the left, a preview of the selected job's pages on the right (with page navigation, like the Print dialog's). -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- ListView+GridView (not the plain ListBox this used to be) gives resizable, headered
                 columns for free — dragging the border between two column headers resizes them, which
                 a plain ListBox showing one concatenated DisplayText string per row can't offer at all.
                 SelectionMode=Extended explicitly enables Ctrl/Shift multi-select for Delete. -->
            <ListView x:Name="JobsListBox" Grid.Column="0" SelectionMode="Extended"
                      Style="{StaticResource AppListView}" ItemContainerStyle="{StaticResource AppListViewItem}"
                      MouseDoubleClick="JobsListBox_MouseDoubleClick" SelectionChanged="JobsListBox_SelectionChanged"
                      PreviewKeyDown="JobsListBox_PreviewKeyDown">
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource AppListHeader}">
                        <GridViewColumn Header="Job" Width="220" DisplayMemberBinding="{Binding DisplayName}"/>
                        <GridViewColumn Header="Pages" Width="55" DisplayMemberBinding="{Binding PageCount}"/>
                        <GridViewColumn Header="Size" Width="70" DisplayMemberBinding="{Binding SizeText}"/>
                        <GridViewColumn Header="Last Modified" Width="140" DisplayMemberBinding="{Binding LastModified, StringFormat=g}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <GroupBox Grid.Column="1" Header="Preview" Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Same look as the Print dialog's and main window's page preview: a white page
                         with a soft drop shadow on the same fixed light-gray canvas (#EEE) the Print
                         dialog uses — the shadow needs that contrast against its background to read as
                         a shadow at all, so this deliberately doesn't follow the dark-mode canvas
                         color (a black shadow is invisible on near-black), and this dialog isn't
                         themed anyway. The Border sizes itself to the image, so the shadow hugs the
                         page's actual edges. The shadow is on this Border, NOT on an element that also
                         clips its content (a clip would cut the shadow off). -->
                    <Border Grid.Row="0" Background="{DynamicResource AppPreviewCanvasBackgroundBrush}" PreviewMouseWheel="PreviewArea_PreviewMouseWheel">
                        <Border x:Name="PreviewPage" Background="White" Margin="14" Visibility="Collapsed"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="1.5" BlurRadius="8" Opacity="0.225"/>
                            </Border.Effect>
                            <Image x:Name="PreviewImageControl" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                    </Border>
                    <!-- Page navigation: first / previous / page box / next / last, the same strip as the Print dialog's preview. Only there when the job has
                         more than one page. The mouse wheel over the page turns pages too. -->
                    <StackPanel x:Name="PreviewNav" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0" Visibility="Collapsed">
                        <Button x:Name="PreviewFirstButton" Style="{StaticResource FlatIconButton}" Width="26" Height="24" Click="PreviewFirst_Click" Margin="0,0,2,0" ToolTip="First page">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPageFirst}" Width="12" Height="12"/>
                        </Button>
                        <Button x:Name="PreviewPrevButton" Style="{StaticResource FlatIconButton}" Width="26" Height="24" Click="PreviewPrev_Click" Margin="0,0,6,0" ToolTip="Previous page">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconChevronLeft}" Width="12" Height="12"/>
                        </Button>
                        <TextBox x:Name="PreviewPageBox" Width="34" Padding="2" FontSize="11" TextAlignment="Center" VerticalContentAlignment="Center"
                                 PreviewKeyDown="PreviewPageBox_PreviewKeyDown" LostFocus="PreviewPageBox_LostFocus"/>
                        <TextBlock x:Name="PreviewPageOfText" VerticalAlignment="Center" FontSize="11" Margin="4,0,8,0"/>
                        <Button x:Name="PreviewNextButton" Style="{StaticResource FlatIconButton}" Width="26" Height="24" Click="PreviewNext_Click" Margin="0,0,2,0" ToolTip="Next page">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconChevronRight}" Width="12" Height="12"/>
                        </Button>
                        <Button x:Name="PreviewLastButton" Style="{StaticResource FlatIconButton}" Width="26" Height="24" Click="PreviewLast_Click" ToolTip="Last page">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPageLast}" Width="12" Height="12"/>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="PreviewCaption" Grid.Row="2" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource AppSecondaryTextBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Read-only usage line. The job cache's LIMITS (max jobs / max size / whether to warn) are
             edited in Settings > General, not here; this just keeps the current usage in view while
             deleting jobs to get back under a limit. -->
        <TextBlock Grid.Row="3" Text="{Binding JobCacheUsageText}" Foreground="{DynamicResource AppSecondaryTextBrush}" Margin="0,8,0,0"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Delete" Click="DeleteButton_Click" Padding="12,4" Margin="0,0,20,0"/>
            <Button Content="Open" Click="OpenButton_Click" Padding="12,4" Margin="0,0,8,0" IsDefault="True"/>
            <Button Content="Cancel" Click="CancelButton_Click" Padding="12,4" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
