<Window x:Class="CleanPrint.App.AboutDialog"
        Icon="pack://application:,,,/Assets/CleanPrint.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:CleanPrint.App.Services"
        svc:UiScaling.Mode="Snapshot"
        Title="About CleanPrint" SizeToContent="WidthAndHeight" MinWidth="340"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource AppWindowBackgroundBrush}" Foreground="{DynamicResource AppWindowForegroundBrush}">
    <StackPanel Margin="28,24,28,20">
        <Image Source="pack://application:,,,/Assets/logo-256.png" Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,10"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="CleanPrint" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock x:Name="VersionText" HorizontalAlignment="Center" Margin="0,4,0,0"
                   Foreground="{DynamicResource AppSecondaryTextBrush}"/>
        <TextBlock Text="Vibe Coded by Softsingh" FontSize="15" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,18,0,0"/>
        <Button Content="OK" Click="OkButton_Click" Padding="22,4" Margin="0,24,0,0"
                HorizontalAlignment="Center" IsDefault="True" IsCancel="True"/>
    </StackPanel>
</Window>
