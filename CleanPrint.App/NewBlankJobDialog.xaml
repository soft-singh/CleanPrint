<Window x:Class="CleanPrint.App.NewBlankJobDialog"
        Icon="pack://application:,,,/Assets/CleanPrint.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:CleanPrint.App.Services"
        xmlns:controls="clr-namespace:CleanPrint.App.Controls"
        svc:UiScaling.Mode="Snapshot"
        Title="New Blank Job" SizeToContent="WidthAndHeight" MinWidth="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource AppWindowBackgroundBrush}" Foreground="{DynamicResource AppWindowForegroundBrush}">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Paper size" VerticalAlignment="Center" Margin="0,0,16,10"/>
        <ComboBox x:Name="PaperCombo" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Width="170" Margin="0,0,0,10"
                  SelectionChanged="Input_Changed"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Orientation" VerticalAlignment="Center" Margin="0,0,16,10"/>
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton x:Name="PortraitRadio" Content="Portrait" GroupName="Orientation" Margin="0,0,18,0" Checked="Input_Changed"/>
            <RadioButton x:Name="LandscapeRadio" Content="Landscape" GroupName="Orientation" Checked="Input_Changed"/>
        </StackPanel>

        <!-- Only for "Custom": the size is typed in, in millimetres or inches. Orientation then follows the numbers (wider than tall = landscape). -->
        <TextBlock x:Name="CustomLabel" Grid.Row="2" Grid.Column="0" Text="Custom size" VerticalAlignment="Center" Margin="0,0,16,10"/>
        <StackPanel x:Name="CustomPanel" Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
            <controls:NumericUpDown x:Name="CustomWidthBox" Width="84" Minimum="1" Maximum="2000" Increment="1" DecimalPlaces="1" Value="210"/>
            <TextBlock Text="×" VerticalAlignment="Center" Margin="8,0,8,0"/>
            <controls:NumericUpDown x:Name="CustomHeightBox" Width="84" Minimum="1" Maximum="2000" Increment="1" DecimalPlaces="1" Value="297"/>
            <ComboBox x:Name="UnitsCombo" Width="62" Margin="10,0,0,0" SelectedIndex="0" SelectionChanged="Input_Changed">
                <ComboBoxItem Content="mm"/>
                <ComboBoxItem Content="in"/>
            </ComboBox>
        </StackPanel>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Resolution" VerticalAlignment="Center" Margin="0,0,16,10"/>
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
            <ComboBox x:Name="DpiCombo" Width="84" IsEditable="True" ToolTip="Dots per inch: how many pixels each inch of paper gets. 300 suits printing; lower is lighter and faster."
                      SelectionChanged="DpiCombo_SelectionChanged" KeyUp="DpiCombo_KeyUp">
                <ComboBoxItem Content="100"/>
                <ComboBoxItem Content="150"/>
                <ComboBoxItem Content="200"/>
                <ComboBoxItem Content="300"/>
                <ComboBoxItem Content="400"/>
                <ComboBoxItem Content="600"/>
            </ComboBox>
            <TextBlock Text="DPI" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Pages" VerticalAlignment="Center" Margin="0,0,16,0"/>
        <controls:NumericUpDown x:Name="PageCountBox" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" Width="84"
                                Minimum="1" Maximum="200" Increment="1" DecimalPlaces="0" Value="1"
                                ToolTip="How many pages to start with. You can add, insert and delete pages afterwards."/>

        <TextBlock x:Name="SummaryText" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,16,0,0" MaxWidth="420"/>
        <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,8,0,0" MaxWidth="420" Foreground="{DynamicResource AppSecondaryTextBrush}"
                   Text="Shapes and text you draw on the page appear in a printout or an export only when &quot;Include in Print&quot; is ticked for them."/>

        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CreateButton" Content="Create" Click="CreateButton_Click" Padding="14,4" Margin="0,0,8,0" IsDefault="True"/>
            <Button Content="Cancel" Click="CancelButton_Click" Padding="14,4" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
