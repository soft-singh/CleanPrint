    <!-- Draws any of the geometries above, filled with AppIconBrush — so every icon follows the theme and the
         one icon-colour setting, with no per-icon colour wiring. Size comes from the
         usage site (Width/Height); Stretch="Uniform" scales the 24x24 artwork to it. -->
    <Style x:Key="IconPath" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <!-- AppIconBrush: a medium-dark grey by default (black icons looked heavy), light grey in dark mode,
             defined with the other theme brushes — shifted lighter or darker by the Settings slider (ThemeManager.SetIconLightness puts
             the chosen colour in the application resources, where it wins over the theme's). -->
        <Setter Property="Fill" Value="{DynamicResource AppIconBrush}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Style.Triggers>
            <!-- The icon no longer takes its colour from the button's Foreground, so a disabled button's
                 dimming has to be applied to the icon itself. -->
            <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
