    <!-- Flat, theme-aware icon button for the title bar, status bar and the page-navigation buttons in dialogs. The icon is a Path from
         Themes/Icons.xaml (solid Material Design Icons artwork — the Segoe MDL2 glyph font these used to
         be was hairline-thin, and a glyph can fall back to a "missing character" box on some machines;
         a path can't), filled with the button's own Foreground so it follows the theme.
         MinWidth=0 overrides the default button style's own 75px minimum; Focusable=False keeps
         a click on a toolbar button from pulling keyboard focus away from the page/shortcuts. -->
    <Style x:Key="FlatIconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AppWindowForegroundBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="1,0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Private mode: a hat and a pair of glasses (the universal "incognito" picture), drawn here from simple shapes. Even-odd fill, so the lenses are rings. -->
