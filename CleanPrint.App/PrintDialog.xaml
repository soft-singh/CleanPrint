<Window x:Class="CleanPrint.App.PrintDialog"
        Icon="pack://application:,,,/Assets/CleanPrint.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:CleanPrint.App.Services"
        svc:UiScaling.Mode="Live"
        xmlns:controls="clr-namespace:CleanPrint.App.Controls"
        xmlns:local="clr-namespace:CleanPrint.App.Converters"
        Title="Print" Height="720" Width="900" MinWidth="820" MinHeight="540" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip" PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource AppWindowBackgroundBrush}" Foreground="{DynamicResource AppWindowForegroundBrush}">
    <Window.Resources>
        <local:InverseBooleanConverter x:Key="InverseBoolean"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <local:EnumToBooleanConverter x:Key="EnumToBoolean"/>
        <local:FitOrScaleToFactorConverter x:Key="FitOrScaleToFactor"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <TabControl Margin="12">
        <TabItem Header="Main">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Left column: printer, page settings, and print mode (Size/Split) — mirrors a
                     conventional print dialog layout: printer/copies up top, page settings below
                     it, then a Print Mode area whose OWN tabs pick what's actually being printed —
                     "Size" (whole page, scaled/fitted) or "Split" (tiled). Which of those two tabs
                     is selected IS PrintWholePage's value (see PrintModeTabControl_SelectionChanged
                     in the code-behind) — there's no separate, redundant toggle for it anymore.

                     A Grid with an explicit Height="*" row for Print Mode (not a plain StackPanel)
                     — a StackPanel never constrains a child's height, it always measures children
                     at their full desired size regardless of available space, so the Split tab's
                     own ScrollViewer would never actually have less room than its content needs and
                     so would never need to scroll. Giving Print Mode a genuinely limited remaining
                     height (whatever's left after the other three boxes take their natural size)
                     is what lets that inner ScrollViewer actually engage. -->
                <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,14,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="Printer" Margin="0,0,0,12">
                        <StackPanel Margin="6">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Printer:" Width="55" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding PrinterNames}" SelectedItem="{Binding SelectedPrinter}" Width="210"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Copies:" Width="55" VerticalAlignment="Center"/>
                                <controls:NumericUpDown Value="{Binding Copies}" Minimum="1" Maximum="99" Increment="1" DecimalPlaces="0"
                                                         Width="52" Height="22"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Row="1" Header="Page Settings" Margin="0,0,0,12">
                        <StackPanel Margin="6">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Paper size:" Width="80" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding PaperSizes}" SelectedItem="{Binding SelectedPaperSizeInfo}"
                                          DisplayMemberPath="Name" Width="185"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Orientation:" Width="80" VerticalAlignment="Center"/>
                                <RadioButton Content="Portrait" GroupName="Orientation" VerticalAlignment="Center" Margin="0,0,15,0"
                                             IsChecked="{Binding IsLandscape, Converter={StaticResource InverseBoolean}}"/>
                                <RadioButton Content="Landscape" GroupName="Orientation" VerticalAlignment="Center"
                                             IsChecked="{Binding IsLandscape}"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Row="2" Header="Page Range" Margin="0,0,0,12">
                        <StackPanel Margin="6">
                            <RadioButton Content="All Pages" GroupName="PageRange" Margin="0,0,0,6"
                                         IsChecked="{Binding PageRangeMode, Converter={StaticResource EnumToBoolean}, ConverterParameter=All}"/>
                            <RadioButton Content="Current Page" GroupName="PageRange" Margin="0,0,0,6"
                                         IsChecked="{Binding PageRangeMode, Converter={StaticResource EnumToBoolean}, ConverterParameter=Current}"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Selected Pages:" GroupName="PageRange" VerticalAlignment="Center" Margin="0,0,6,0"
                                             IsChecked="{Binding PageRangeMode, Converter={StaticResource EnumToBoolean}, ConverterParameter=Selected}"/>
                                <TextBox Text="{Binding SelectedPagesRangeText, UpdateSourceTrigger=PropertyChanged}" Width="120" Padding="2"
                                         IsEnabled="{Binding PageRangeMode, Converter={StaticResource EnumToBoolean}, ConverterParameter=Selected}"
                                         ToolTip="e.g. 1-3,5,8-10"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Row="3" Header="Print Mode">
                        <TabControl x:Name="PrintModeTabControl" Margin="8" BorderBrush="{DynamicResource ThemeLineBrush}" BorderThickness="0,1,0,0"
                                    SelectionChanged="PrintModeTabControl_SelectionChanged">
                            <TabItem Header="Size">
                                <StackPanel Margin="10">
                                    <!-- Mutually exclusive (not a checkbox + independent textbox,
                                         which previously let both be "on" at once with no clear
                                         precedence between them — Fit to Page computes its own
                                         scale dynamically from the content/page size, while a
                                         custom percentage is a fixed factor). -->
                                    <RadioButton Content="Fit to page" GroupName="ScaleMode" Margin="0,0,0,10"
                                                 IsChecked="{Binding FitToPage}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Scale to:" GroupName="ScaleMode" VerticalAlignment="Center" Margin="0,0,6,0"
                                                     IsChecked="{Binding FitToPage, Converter={StaticResource InverseBoolean}}"/>
                                        <controls:NumericUpDown Value="{Binding ScalePercent}" Minimum="1" Maximum="500" Increment="1" DecimalPlaces="0"
                                                                 Width="52" Height="22" Margin="0,0,4,0"
                                                                 IsEnabled="{Binding FitToPage, Converter={StaticResource InverseBoolean}}"/>
                                        <TextBlock Text="%" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </TabItem>

                            <TabItem Header="Split">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="Rows:" VerticalAlignment="Center"/>
                                        <controls:NumericUpDown Value="{Binding SplitRows}" Minimum="1" Maximum="20" Increment="1" DecimalPlaces="0"
                                                                 Width="46" Height="22" Margin="4,0,10,0"/>
                                        <TextBlock Text="Columns:" VerticalAlignment="Center"/>
                                        <controls:NumericUpDown Value="{Binding SplitColumns}" Minimum="1" Maximum="20" Increment="1" DecimalPlaces="0"
                                                                 Width="46" Height="22" Margin="4,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="Overlap (px):" VerticalAlignment="Center"/>
                                        <controls:NumericUpDown Value="{Binding OverlapPixels}" Minimum="0" Maximum="500" Increment="5" DecimalPlaces="0"
                                                                 Width="52" Height="22" Margin="4,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Button Content="Apply (This Page)" Command="{Binding ApplySplitCommand}" Padding="8,4" Margin="0,0,8,0"/>
                                        <Button Content="Process All Pages" Command="{Binding ApplySplitAllPagesCommand}" Padding="8,4" FontWeight="Bold"/>
                                    </StackPanel>

                                    <Border BorderBrush="{DynamicResource ThemeLineBrush}" BorderThickness="1" Padding="8">
                                        <StackPanel>
                                            <CheckBox Content="Custom settings for this page" IsChecked="{Binding UseOverrideForCurrentPage}" Margin="0,0,0,8"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6" IsEnabled="{Binding UseOverrideForCurrentPage}">
                                                <TextBlock Text="Rows:" VerticalAlignment="Center"/>
                                                <controls:NumericUpDown Value="{Binding OverrideRows}" Minimum="1" Maximum="20" Increment="1" DecimalPlaces="0"
                                                                         Width="46" Height="22" Margin="4,0,10,0"/>
                                                <TextBlock Text="Columns:" VerticalAlignment="Center"/>
                                                <controls:NumericUpDown Value="{Binding OverrideColumns}" Minimum="1" Maximum="20" Increment="1" DecimalPlaces="0"
                                                                         Width="46" Height="22" Margin="4,0,0,0"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" IsEnabled="{Binding UseOverrideForCurrentPage}">
                                                <TextBlock Text="Overlap (px):" VerticalAlignment="Center"/>
                                                <controls:NumericUpDown Value="{Binding OverrideOverlapPixels}" Minimum="0" Maximum="500" Increment="5" DecimalPlaces="0"
                                                                         Width="52" Height="22" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource AppSecondaryTextBrush}" FontStyle="Italic" FontSize="11" TextWrapping="Wrap">
                                        <Run Text="{Binding OverrideCount, Mode=OneWay}"/>
                                        <Run Text=" page(s) in this job have custom settings"/>
                                    </TextBlock>

                                    <!-- Moved here from the shared area next to Print — the main
                                         window has its own dedicated Export button for the current
                                         whole page, so the only export this dialog still needs to
                                         offer is for split tiles specifically, which only exist
                                         here. By the time this button is reachable, PrintWholePage
                                         is already false (this tab being active is what sets it),
                                         so ExportAsync's existing split-tiles branch runs. -->
                                    <Button Content="Export Split Tiles..." Click="ExportButton_Click" Padding="8,4" Margin="0,12,0,0"
                                            HorizontalAlignment="Left"
                                            ToolTip="Save the current split tiles as PNG/JPG, at actual image size (one file per tile)."/>
                                </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </GroupBox>
                </Grid>

                <!-- Right column: the preview switches with the selected Print Mode tab — the
                     current page itself (as already shown in the main window, but visible here too
                     so this dialog doesn't feel blank while Size is selected) when Size is active,
                     or every split tile once Split mode has actually been applied. Both bind to
                     PrintWholePage — true means Size is selected — with one showing normally and
                     the other via its inverse, so exactly one is ever visible.

                     No inner row-stacking Grid here anymore (previously Preview/status/Print
                     stacked in one column) — status was removed (StatusText is already visible in
                     MainWindow at all times, so repeating it here was redundant) and Print moved to
                     its own row spanning both columns below (see Grid.Row="1" further down) — with
                     nothing else left to stack, Preview can just fill this whole column directly,
                     and its bottom edge now lines up with Print Mode's on the left, since neither
                     needs to leave room for anything below it within its own column anymore. -->
                <GroupBox Grid.Row="0" Grid.Column="1" Header="Preview">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Matches MainWindow's own preview canvas background (#EEE, light gray)
                             exactly — without it, the white sheet sits directly against this
                             GroupBox's own near-white background, and the drop shadow (a
                             semi-transparent black blur) has nowhere near enough contrast to read
                             as "a page floating above a shadow" — it just looks like a thick,
                             blurry outline hugging the page edge instead. Wraps BOTH the Size-mode
                             sheet and the Split-mode tile grid (they occupy the same Grid.Row="0",
                             toggled by Visibility) so the gray shows through whichever one is
                             hidden and provides that contrast for whichever is visible. -->
                        <Border Grid.Row="0" Background="{DynamicResource AppPreviewCanvasBackgroundBrush}">
                        <Grid>
                        <!-- A "sheet" shaped to match the selected paper orientation (a fixed,
                             representative portrait/landscape ratio, not the exact selected
                             paper size's own dimensions — close enough for a preview without
                             needing to plumb PaperSize's actual width/height through here) —
                             Viewbox scales it to fill whatever space is available while keeping
                             that shape. Styled to match MainWindow's own page preview exactly:
                             white background + DropShadowEffect (no hard border line) rather than
                             a bordered rectangle, and RenderOptions.BitmapScalingMode="HighQuality"
                             on the Image — without that, WPF's default (lower-quality) downscaling
                             for a large source bitmap shown much smaller here washes out fine
                             text detail into a faded, blurry result. The image itself is scaled via
                             RenderTransform by FitOrScaleToFactor (see that converter), so
                             switching to a custom scale percentage and changing it actually grows/
                             shrinks the previewed page within the sheet, rather than the preview
                             always filling the sheet regardless of the selected scale mode.
                             RenderTransform specifically, NOT LayoutTransform — LayoutTransform
                             changes the size the layout system measures/arranges the Image at
                             BEFORE Stretch="Uniform" runs, so the image just re-stretches to fill
                             whatever (transformed) space it receives, and the two largely cancel
                             out — RenderTransform instead leaves layout alone (the image is still
                             measured/arranged at its normal "fill the sheet" size) and scales
                             purely the rendered output afterward, which is what actually produces a
                             visible size change here. RenderTransformOrigin=0.5,0.5 keeps it
                             centered as it grows/shrinks rather than anchored at a corner.
                             ClipToBounds stays on despite the removed border — a scale over 100%
                             should still clip at the page's edge instead of spilling past the white
                             sheet, which is now defined by fill + shadow rather than a drawn line. -->
                        <Viewbox Grid.Row="0" Stretch="Uniform" Margin="10"
                                 Visibility="{Binding PrintWholePage, Converter={StaticResource BoolToVisibility}}">
                            <!-- ClipToBounds moved to an INNER wrapper around just the Image,
                                 separate from the OUTER "sheet" Border that carries the
                                 DropShadowEffect — a shadow renders OUTSIDE its element's own
                                 geometric bounds (that's the blur radius bleeding past the edge),
                                 so ClipToBounds="True" on the SAME element as the Effect was
                                 clipping the shadow away entirely, leaving only a flat white
                                 rectangle with no visible depth — which is exactly what looked like
                                 "the page boundary is still visible, no drop shadow". The outer
                                 Border here is now unclipped so its shadow renders in full; the
                                 inner Border still clips the Image, so a scale over 100% still
                                 stops at the page edge instead of spilling past it. -->
                            <!-- Clicking the page toggles Portrait/Landscape (MouseLeftButtonDown below). -->
                            <Border Background="White" Cursor="Hand" MouseLeftButtonDown="PreviewSheet_MouseLeftButtonDown"
                                    ToolTip="Click to switch between Portrait and Landscape">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="1.5" BlurRadius="8" Opacity="0.225"/>
                                </Border.Effect>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Width" Value="850"/>
                                        <Setter Property="Height" Value="1100"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PreviewIsLandscape}" Value="True">
                                                <Setter Property="Width" Value="1100"/>
                                                <Setter Property="Height" Value="850"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border ClipToBounds="True">
                                    <Image Source="{Binding PrintPreviewImage}" Stretch="Uniform" Margin="14"
                                           RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5">
                                        <Image.RenderTransform>
                                            <ScaleTransform>
                                                <ScaleTransform.ScaleX>
                                                    <MultiBinding Converter="{StaticResource FitOrScaleToFactor}">
                                                        <Binding Path="PreviewFitToPage"/>
                                                        <Binding Path="PreviewScalePercent"/>
                                                    </MultiBinding>
                                                </ScaleTransform.ScaleX>
                                                <ScaleTransform.ScaleY>
                                                    <MultiBinding Converter="{StaticResource FitOrScaleToFactor}">
                                                        <Binding Path="PreviewFitToPage"/>
                                                        <Binding Path="PreviewScalePercent"/>
                                                    </MultiBinding>
                                                </ScaleTransform.ScaleY>
                                            </ScaleTransform>
                                        </Image.RenderTransform>
                                    </Image>
                                </Border>
                            </Border>
                        </Viewbox>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding PrintWholePage, Converter={StaticResource InverseBoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding SplitPreviewTiles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6" Width="140">
                                            <Border BorderBrush="{DynamicResource ThemeInputBorderBrush}" BorderThickness="1">
                                                <Image Source="{Binding Image}" Height="120" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" TextAlignment="Center" FontSize="11" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Preview renders (effects, crop, polygons, hidden areas) take a moment for
                             a large page — this just says so instead of looking frozen. -->
                        <TextBlock Text="Rendering preview..." Foreground="{DynamicResource AppSecondaryTextBrush}" FontSize="11" Margin="8,6,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"
                                   Visibility="{Binding IsPrintPreviewRendering, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                        </Border>

                        <!-- Page navigation — Size mode only (Split's preview already shows every
                             tile at once in a grid, so there's no single "current page" to page
                             through there). This pages the PREVIEW ONLY, on its own index inside
                             MainViewModel (PrintPreviewPageNumber / PrintPreviewPreviousCommand /
                             PrintPreviewNextCommand) — it deliberately does NOT move the main
                             window's page (an earlier version shared the main window's own
                             commands, so paging here also changed the main window, which was
                             unwanted). First/Last are plain Click handlers (no command to bind).
                             The page box commits on Enter or when it loses focus, not on every
                             keystroke — each commit renders a page, and typing "12" shouldn't
                             render page 1 on the way to page 12. -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0"
                                    Visibility="{Binding PrintWholePage, Converter={StaticResource BoolToVisibility}}">
                            <Button Style="{StaticResource FlatIconButton}" Width="26" Height="24" Click="FirstPageButton_Click" Margin="0,0,2,0" ToolTip="First page">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPageFirst}" Width="12" Height="12"/>
                            </Button>
                            <Button Style="{StaticResource FlatIconButton}" Width="26" Height="24" Command="{Binding PrintPreviewPreviousCommand}" Margin="0,0,6,0" ToolTip="Previous page">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconChevronLeft}" Width="12" Height="12"/>
                            </Button>
                            <TextBox Text="{Binding PrintPreviewPageNumber, UpdateSourceTrigger=LostFocus}" Width="34" Padding="2" FontSize="11"
                                     TextAlignment="Center" VerticalContentAlignment="Center"
                                     PreviewKeyDown="PageNumberTextBox_PreviewKeyDown"/>
                            <TextBlock VerticalAlignment="Center" FontSize="11" Margin="4,0,8,0">
                                <Run Text="of"/>
                                <Run Text="{Binding PrintPreviewPageCount, Mode=OneWay}"/>
                            </TextBlock>
                            <Button Style="{StaticResource FlatIconButton}" Width="26" Height="24" Command="{Binding PrintPreviewNextCommand}" Margin="0,0,2,0" ToolTip="Next page">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconChevronRight}" Width="12" Height="12"/>
                            </Button>
                            <Button Style="{StaticResource FlatIconButton}" Width="26" Height="24" Click="LastPageButton_Click" ToolTip="Last page">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPageLast}" Width="12" Height="12"/>
                            </Button>
                        </StackPanel>

                        <!-- Under the page navigation, because it is about THE PAGE BEING PREVIEWED. The preview and the page box move through the pages of the Page Range only (so
                             choosing Current Page, or typing 2,5, leaves just those); the line below says which page of the job is showing. Ticking the box gives this page its own paper
                             size, orientation and scale — the other pages keep the common Page Settings on the left — and they all still go out as one print job. Size mode only. -->
                        <StackPanel Grid.Row="2" Visibility="{Binding PrintWholePage, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding PrintPreviewStatusText}" Foreground="{DynamicResource AppSecondaryTextBrush}" FontSize="11" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            <!-- Nothing for a job of one page (there is no "other page" to differ from). Otherwise just a header line, which opens and closes the settings — closed by default, so
                                 the preview above gets the room. -->
                            <Border BorderBrush="{DynamicResource ThemeLineBrush}" BorderThickness="1" Padding="8,5" Margin="0,8,0,0" IsEnabled="{Binding HasPrintPreviewPages}"
                                    Visibility="{Binding HasMultiplePages, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <ToggleButton IsChecked="{Binding PageSettingsPanelExpanded}" Focusable="False" Cursor="Hand" HorizontalContentAlignment="Stretch"
                                                  ToolTip="Show or hide this page's own paper size, orientation and scale.">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <ContentPresenter HorizontalAlignment="Stretch"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                        <DockPanel LastChildFill="True" Background="Transparent">
                                            <Path DockPanel.Dock="Right" Data="{StaticResource IconChevronRight}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"
                                                  Fill="{DynamicResource AppIconBrush}" RenderTransformOrigin="0.5,0.5">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value><RotateTransform Angle="0"/></Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PageSettingsPanelExpanded}" Value="True">
                                                                <Setter Property="RenderTransform">
                                                                    <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <TextBlock Text="{Binding PageSettingsToggleText}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </ToggleButton>
                                    <StackPanel Visibility="{Binding PageSettingsPanelExpanded, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
                                    <CheckBox Content="Use different settings for this page" IsChecked="{Binding UsePageSettingsOverride}"
                                              ToolTip="Give this page its own paper size, orientation and scale. The other pages keep the common Page Settings."/>
                                    <StackPanel IsEnabled="{Binding UsePageSettingsOverride}" Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="Paper size:" Width="78" VerticalAlignment="Center"/>
                                            <ComboBox ItemsSource="{Binding PaperSizes}" SelectedItem="{Binding OverridePaperSizeInfo}" DisplayMemberPath="Name" Width="170"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="Orientation:" Width="78" VerticalAlignment="Center"/>
                                            <RadioButton Content="Portrait" GroupName="OverrideOrientation" VerticalAlignment="Center" Margin="0,0,15,0"
                                                         IsChecked="{Binding OverrideIsLandscape, Converter={StaticResource InverseBoolean}}"/>
                                            <RadioButton Content="Landscape" GroupName="OverrideOrientation" VerticalAlignment="Center"
                                                         IsChecked="{Binding OverrideIsLandscape}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Size:" Width="78" VerticalAlignment="Center"/>
                                            <RadioButton Content="Fit to page" GroupName="OverrideScaleMode" VerticalAlignment="Center" Margin="0,0,15,0"
                                                         IsChecked="{Binding OverrideFitToPage}"/>
                                            <RadioButton Content="Scale to:" GroupName="OverrideScaleMode" VerticalAlignment="Center" Margin="0,0,6,0"
                                                         IsChecked="{Binding OverrideFitToPage, Converter={StaticResource InverseBoolean}}"/>
                                            <controls:NumericUpDown Value="{Binding OverrideScalePercent}" Minimum="10" Maximum="500" Increment="1" DecimalPlaces="0"
                                                                     Width="52" Height="22" Margin="0,0,4,0"
                                                                     IsEnabled="{Binding OverrideFitToPage, Converter={StaticResource InverseBoolean}}"/>
                                            <TextBlock Text="%" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource AppSecondaryTextBrush}" FontStyle="Italic" FontSize="11" TextWrapping="Wrap">
                                        <Run Text="{Binding PageSettingsOverrideCount, Mode=OneWay}"/>
                                        <Run Text=" page(s) in this job have settings of their own"/>
                                    </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Print spans both columns, below everything — kept out of either column
                     specifically so neither Print Mode (left) nor Preview (right) has to leave
                     room for it within its own column, which is what let their bottom edges
                     misalign now that the status row between them and this button is gone. -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="Print" Click="PrintAllButton_Click" Padding="20,6" FontWeight="Bold" FontSize="13"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- Moved here from SettingsDialog: margins/page numbers are more directly related to
             split/print than to the General tab's own contents (default preset, zoom precision). -->
        <TabItem Header="Page Setup">
            <StackPanel Margin="12">
                <TextBlock Text="Margins (inches)" FontWeight="Bold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="L" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <controls:NumericUpDown Value="{Binding MarginLeftInches}" Minimum="0" Maximum="5" Increment="0.05" DecimalPlaces="2"
                                             Width="55" Height="22" Margin="0,0,10,0"/>
                    <TextBlock Text="T" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <controls:NumericUpDown Value="{Binding MarginTopInches}" Minimum="0" Maximum="5" Increment="0.05" DecimalPlaces="2"
                                             Width="55" Height="22" Margin="0,0,10,0"/>
                    <TextBlock Text="R" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <controls:NumericUpDown Value="{Binding MarginRightInches}" Minimum="0" Maximum="5" Increment="0.05" DecimalPlaces="2"
                                             Width="55" Height="22" Margin="0,0,10,0"/>
                    <TextBlock Text="B" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <controls:NumericUpDown Value="{Binding MarginBottomInches}" Minimum="0" Maximum="5" Increment="0.05" DecimalPlaces="2"
                                             Width="55" Height="22"/>
                </StackPanel>

                <TextBlock Text="Page Numbers" FontWeight="Bold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="Show page numbers" IsChecked="{Binding ShowPageNumbers}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox ItemsSource="{Binding PageNumberPositions}" SelectedItem="{Binding SelectedPageNumberPosition}"
                              Width="150" IsEnabled="{Binding ShowPageNumbers}"/>
                </StackPanel>
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
