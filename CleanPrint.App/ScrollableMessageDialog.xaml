<Window x:Class="CleanPrint.App.ScrollableMessageDialog"
        Icon="pack://application:,,,/Assets/CleanPrint.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:CleanPrint.App.Services"
        svc:UiScaling.Mode="Snapshot"
        SizeToContent="Height" Width="480" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource AppWindowBackgroundBrush}" Foreground="{DynamicResource AppWindowForegroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ItemsListControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,3"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="YesButton" Content="Yes" Click="YesButton_Click" Padding="14,4" Margin="0,0,8,0" IsDefault="True"/>
            <Button x:Name="NoButton" Content="No" Click="NoButton_Click" Padding="14,4" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
